#!/bin/bash
# Pre-commit hook template for AI-Native Development Workflow
# This hook runs security scans before allowing commits

set -e

echo "🔒 Running pre-commit security checks..."

# Color codes
GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

ERRORS=0

# Check 1: git-secrets (AWS secrets, API keys)
if command -v git-secrets &> /dev/null; then
    echo "🔍 Scanning for secrets with git-secrets..."
    if git secrets --scan; then
        echo -e "${GREEN}✅ git-secrets: No secrets detected${NC}"
    else
        echo -e "${RED}❌ git-secrets: Secrets detected!${NC}"
        echo -e "${RED}   Commit BLOCKED. Remove secrets before committing.${NC}"
        ((ERRORS++))
    fi
else
    echo -e "${YELLOW}⚠️  git-secrets not installed. Skipping...${NC}"
    echo -e "${YELLOW}   Install: brew install git-secrets${NC}"
fi

# Check 2: trufflehog (entropy-based detection)
if command -v trufflehog &> /dev/null; then
    echo "🔍 Scanning for high-entropy strings with trufflehog..."
    # Scan only staged files
    STAGED_FILES=$(git diff --cached --name-only)
    if [ -n "$STAGED_FILES" ]; then
        if echo "$STAGED_FILES" | xargs trufflehog filesystem --no-update --fail 2>&1 | grep -q "Found verified result"; then
            echo -e "${RED}❌ trufflehog: High-entropy secrets detected!${NC}"
            echo -e "${RED}   Commit BLOCKED. Review findings above.${NC}"
            ((ERRORS++))
        else
            echo -e "${GREEN}✅ trufflehog: No high-entropy secrets${NC}"
        fi
    fi
else
    echo -e "${YELLOW}⚠️  trufflehog not installed. Skipping...${NC}"
    echo -e "${YELLOW}   Install: brew install trufflehog${NC}"
fi

# Check 3: TODO/FIXME in critical paths (optional)
echo "🔍 Checking for TODO/FIXME in critical files..."
CRITICAL_PATTERN="(auth|payment|security|migration|crypto)"
STAGED_FILES=$(git diff --cached --name-only)

if echo "$STAGED_FILES" | grep -qE "$CRITICAL_PATTERN"; then
    if git diff --cached | grep -E "^\+.*(\bTODO\b|\bFIXME\b)" > /dev/null; then
        echo -e "${YELLOW}⚠️  Warning: TODO/FIXME found in critical files${NC}"
        echo -e "${YELLOW}   Consider resolving before commit.${NC}"
        # Not blocking, just warning
    fi
fi

echo ""
echo "==============================="
if [ $ERRORS -eq 0 ]; then
    echo -e "${GREEN}✅ Security checks passed. Proceeding with commit...${NC}"
    exit 0
else
    echo -e "${RED}❌ Security checks FAILED. Commit BLOCKED.${NC}"
    echo -e "${RED}   Fix issues above and try again.${NC}"
    exit 1
fi
